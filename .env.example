# 🔒 NEVER commit .env.local with real keys!
# This is just an example template

# Massa Wallet Private Key (REQUIRED for scripts)
PRIVATE_KEY=YOUR_PRIVATE_KEY_HERE
SECRET_KEY=YOUR_SECRET_KEY_HERE

# RPC Endpoints
JSON_RPC_URL_PUBLIC=https://buildnet.massa.net/api/v2
VITE_RPC_URL=https://buildnet.massa.net/api/v2

# Smart Contract Addresses (Update after deployment)
VAULT_ADDR=AS1xxx...
FUNDABLE_VAULT_ADDR=AS1xxx...
FAST_VAULT_ADDR=AS1xxx...
VITE_VAULT_ADDRESS=AS1xxx...
VITE_VAULT_ADDR=AS1xxx...

# DeWeb Configuration (Optional)
DEWEB_ADDRESS=AS1xxx...

# Test Wallets (For development only - DO NOT USE REAL FUNDS)
SECRET_KEY2=YOUR_TEST_WALLET_2
SECRET_KEY3=YOUR_TEST_WALLET_3
